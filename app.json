{
  "expo": {
    "name": "AIV Network",
    "slug": "aiv-network-mobile",
    "scheme": "aivnetwork",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aivnetwork.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "AIV Network does not use the camera, but this permission may be requested by third-party SDKs used in the app."
      }
    },
    "android": {
      "package": "com.aivnetwork.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-4013153499723354~6242106140",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f12cdd0f-f1cc-4614-b1b8-36c80d5e0a3e"
      }
    }
  }
}
	