{
  "expo": {
    "name": "AIV Network",
    "slug": "aiv-network-mobile",
    "scheme": "aivnetwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aivnetwork.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.aivnetwork.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
